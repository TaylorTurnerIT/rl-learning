# Self-contained devenv integration for direnv
if ! type -t use_devenv >/dev/null 2>&1; then
  use_devenv() {
    watch_file devenv.nix
    watch_file devenv.yaml
    watch_file devenv.lock
    if command -v devenv >/dev/null 2>&1; then
      eval "$(devenv print-dev-env)"
    else
      eval "$(nix shell nixpkgs#devenv --command devenv print-dev-env)"
    fi
  }
fi

use devenv
